# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 打包产物（仓库保留 dist/Lookout 便携可执行版，便于克隆即用）----
build/
dist/*
!dist/Lookout/
dist/Lookout/data/
dist/Lookout/**/__pycache__/
dist_prev/
*.spec
!installer/Lookout.spec
*.spec.bak

# ---- 运行数据（不该进仓库）----
data/
!data/.gitkeep
*.db
*.db-shm
*.db-wal
*.log
*.rad
!tests/fixtures/*.rad
capture*.bin
tiles/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地临时 ----
_t.py
_v.py
_w.py
_*.png
